DATABASE_URL=postgres://localhost:5432/cassie_indexer

# Dynamic — email sign-up / sign-in
# Create an environment at https://app.dynamic.xyz/dashboard/developer/api
# Enable Email OTP. Add http://localhost:5173 to Allowed Origins.
PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Server-only delegation webhook. Never use PUBLIC_ prefixes for these.
# Register /api/trading/delegation/webhook for created and revoked events.
DYNAMIC_WEBHOOK_SECRET=
DYNAMIC_DELEGATION_PRIVATE_KEY=
DYNAMIC_API_KEY=
DEFINITIVE_API_KEY=
# Optional authenticated Base RPC; defaults to Base's public endpoint.
BASE_RPC_URL=
